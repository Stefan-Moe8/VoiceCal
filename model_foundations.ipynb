   "source": [
    "Develop and experiment with LLM prompts. Test whether the model correctly extracts event titles, dates, times, and other details from natural-language requests. Compare prompts and inspect mistakes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "1c24f120",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "OpenAI API key loaded from the .env file in this folder.\n"
     ]
    }
   ],
   "source": [
    "# Find your OpenAI API KEY\n",
    "import getpass\n",
    "import io\n",
    "import os\n",
    "import re\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "# Environment detection and shared messages\n",
    "IN_COLAB = \"google.colab\" in sys.modules\n",
    "IN_NOTEBOOK = \"ipykernel\" in sys.modules\n",
    "AGAIN = \"run this cell again\"\n",
    "RESTART = \"restart the kernel and run all cells\"\n",
    "\n",
    "\n",
    "class SetupError(Exception):\n",
    "    \"\"\"A setup problem with a plain-language fix. Notebooks show only the message, without a traceback.\"\"\"\n",
    "\n",
    "    def _render_traceback_(self):\n",
    "        return [f\"SetupError: {self}\"]\n",
    "\n",
    "\n",
    "def how_to_add_a_key():\n",
    "    if IN_NOTEBOOK:\n",
    "        return \"\"\"No OpenAI API key found. Do one of these, then run this cell again:\n",
    "- Colab: click the key icon in the left sidebar, add a secret named OPENAI_API_KEY, and turn on Notebook access.\n",
    "- VS Code, Jupyter, or Anaconda: create a file named .env next to this notebook with one line:\n",
    "  OPENAI_API_KEY=sk-...your key...\n",
    "- Anywhere: set the OPENAI_API_KEY environment variable, then restart Jupyter.\"\"\"\n",
    "    return f\"\"\"No OpenAI API key found. Do one of these, then start the app again:\n",
    "- Create a file named .env next to {Path(sys.argv[0]).name} (or in the folder you start it from) with one line:\n",
    "  OPENAI_API_KEY=sk-...your key...\n",
    "- Or set the OPENAI_API_KEY environment variable in this terminal.\"\"\"\n",
    "\n",
    "\n",
    "def find_env_file():\n",
    "    \"\"\"The nearest .env file: next to this script, in the working folder, or in a parent folder.\"\"\"\n",
    "    folders = [Path.cwd(), *Path.cwd().parents]\n",
    "    if \"__file__\" in globals():\n",
    "        folders.insert(0, Path(__file__).resolve().parent)\n",
    "    for folder in folders:\n",
    "        if (folder / \".env\").is_file():\n",
    "            return folder / \".env\"\n",
    "    return None\n",
    "\n",
    "\n",
    "def where_is(path):\n",
    "    \"\"\"Where a file is, relative to the working folder. (A full path is long, and it can be personal.)\"\"\"\n",
    "    folder, cwd = path.parent, Path.cwd()\n",
    "    if folder == cwd:\n",
    "        return f\"the {path.name} file in this folder\"\n",
    "    if folder in cwd.parents:\n",
    "        up = len(cwd.parts) - len(folder.parts)\n",
    "        return f\"the {path.name} file {up} folder{'s' if up > 1 else ''} up ({'../' * up}{path.name})\"\n",
    "    return f\"the {path.name} file next to {Path(sys.argv[0]).name}\"\n",
    "\n",
    "\n",
    "def read_env_file(path):\n",
    "    \"\"\"KEY=VALUE pairs from a .env file (python-dotenv if it works, otherwise a small built-in parser).\n",
    "\n",
    "    Also reads UTF-16 files, which Windows PowerShell 5 writes for `echo OPENAI_API_KEY=... > .env`.\n",
    "    \"\"\"\n",
    "    data = path.read_bytes()\n",
    "    utf16 = data[:2] in (b\"\\xff\\xfe\", b\"\\xfe\\xff\")\n",
    "    if not utf16 and b\"\\x00\" in data:  # UTF-16 without a BOM, e.g. PowerShell 5 `>>` onto a UTF-8 file\n",
    "        data = data.replace(b\"\\x00\", b\"\")  # the key and names are ASCII, so dropping zero bytes recovers them\n",
    "    try:\n",
    "        text = data.decode(\"utf-16\") if utf16 else data.decode(\"utf-8-sig\")\n",
    "    except UnicodeDecodeError:\n",
    "        where = where_is(path)\n",
    "        raise SetupError(\n",
    "            f\"{where[0].upper() + where[1:]} is not plain text (UTF-8). \"\n",
    "            f\"Re-create it in VS Code or Notepad, save it as UTF-8, then {AGAIN}.\"\n",
    "        ) from None\n",
    "    try:\n",
    "        from dotenv import dotenv_values\n",
    "\n",
    "        return {k: v for k, v in dotenv_values(stream=io.StringIO(text)).items() if v is not None}\n",
    "    except Exception:  # python-dotenv is missing or too old: parse the usual cases here\n",
    "        pass\n",
    "    values = {}\n",
    "    for line in text.splitlines():\n",
    "        line = re.sub(r\"^export\\s+\", \"\", line.strip())\n",
    "        if not line or line.startswith(\"#\") or \"=\" not in line:\n",
    "            continue\n",
    "        name, value = (part.strip() for part in line.split(\"=\", 1))\n",
    "        if value[:1] in (\"'\", '\"') and value[0] in value[1:]:  # quoted: keep what is inside the quotes\n",
    "            value = value[1 : value.index(value[0], 1)]\n",
    "        else:\n",
    "            value = re.split(r\"\\s+#\", value, maxsplit=1)[0].strip()  # drop an inline comment\n",
    "        values[name] = value\n",
    "    return values\n",
    "\n",
    "\n",
    "def key_from_colab():\n",
    "    \"\"\"The OPENAI_API_KEY secret from Colab Secrets, or None if it is not there.\"\"\"\n",
    "    from google.colab import userdata\n",
    "\n",
    "    try:\n",
    "        return userdata.get(\"OPENAI_API_KEY\")\n",
    "    except Exception as e:  # SecretNotFoundError or NotebookAccessError\n",
    "        if type(e).__name__ == \"NotebookAccessError\":\n",
    "            raise SetupError(\n",
    "                \"Colab has an OPENAI_API_KEY secret, but this notebook may not read it. Click the key icon \"\n",
    "                \"in the left sidebar, turn on Notebook access for OPENAI_API_KEY, and run this cell again.\"\n",
    "            ) from None\n",
    "        return None\n",
    "\n",
    "\n",
    "def can_prompt():\n",
    "    \"\"\"True if we can ask for the key: in a notebook, or in a script run from a terminal.\"\"\"\n",
    "    try:\n",
    "        return IN_NOTEBOOK or sys.stdin.isatty()\n",
    "    except (AttributeError, ValueError):  # no stdin at all, or it is closed\n",
    "        return False\n",
    "\n",
    "\n",
    "def load_api_key():\n",
    "    \"\"\"Find OPENAI_API_KEY and put it in os.environ. Returns where it came from; never prints the key.\n",
    "\n",
    "    Order: environment variable, .env file, Colab Secrets, and finally a hidden prompt.\n",
    "    \"\"\"\n",
    "    if os.environ.get(\"DEMO_RESTART_NEEDED\"):\n",
    "        raise SetupError(f\"RESTART NEEDED: the first cell updated {os.environ['DEMO_RESTART_NEEDED']}, so {RESTART}.\")\n",
    "    source = None\n",
    "    if os.environ.get(\"OPENAI_API_KEY\", \"\").strip():\n",
    "        source = \"The OPENAI_API_KEY environment variable\"\n",
    "    else:\n",
    "        os.environ.pop(\"OPENAI_API_KEY\", None)  # an empty variable should not block the .env file\n",
    "    env_file = find_env_file()\n",
    "    if env_file:  # also loads other settings, never overriding existing ones\n",
    "        for name, value in read_env_file(env_file).items():\n",
    "            if \"\\x00\" not in name + value:  # os.environ cannot hold zero bytes\n",
    "                os.environ.setdefault(name, value)\n",
    "        if source is None and os.environ.get(\"OPENAI_API_KEY\", \"\").strip():\n",
    "            source = where_is(env_file)\n",
    "    if source is None and IN_COLAB:\n",
    "        key = key_from_colab()\n",
    "        if key:\n",
    "            os.environ[\"OPENAI_API_KEY\"] = key\n",
    "            source = \"Colab Secrets\"\n",
    "    if source is None and can_prompt():\n",
    "        try:\n",
    "            key = getpass.getpass(\"Paste your OpenAI API key (hidden), then press Enter: \")\n",
    "        except Exception:  # no way to ask, for example when the notebook runs unattended\n",
    "            key = \"\"\n",
    "        if key.strip():\n",
    "            os.environ[\"OPENAI_API_KEY\"] = key\n",
    "            source = \"the key you pasted (kept for this session only)\"\n",
    "    if source is None and env_file:\n",
    "        raise SetupError(\n",
    "            f\"Found {where_is(env_file)}, but it has no OPENAI_API_KEY value. \"\n",
    "            f\"Add the line OPENAI_API_KEY=sk-...your key... to it, then {AGAIN}.\"\n",
    "        )\n",
    "    if source is None:\n",
    "        hint = \"\\nNote: this folder has a file named .env.txt; rename it to .env.\" if Path(\".env.txt\").exists() else \"\"\n",
    "        raise SetupError(how_to_add_a_key() + hint)\n",
    "\n",
    "    key = (\n",
    "        os.environ[\"OPENAI_API_KEY\"]\n",
    "        .strip()\n",
    "        .strip(\"'\\\"“”‘’\")\n",
    "        .replace(\"\\u200b\", \"\")  # zero-width space\n",
    "        .replace(\"\\ufeff\", \"\")  # byte order mark\n",
    "    )\n",
    "    if key.startswith(\"sk-your\") or key.endswith(\"...\"):\n",
    "        raise SetupError(f\"The key in {source} is still the placeholder text. Replace it with your real key.\")\n",
    "    if not key.isascii() or any(c.isspace() for c in key):\n",
    "        raise SetupError(\n",
    "            f\"The key in {source} contains characters that are not part of an API key (for example curly quotes, \"\n",
    "            f\"a space, or an invisible character from a word processor or chat app). Paste it again as plain text, then {AGAIN}.\"\n",
    "        )\n",
    "    os.environ[\"OPENAI_API_KEY\"] = key\n",
    "    return source\n",
    "\n",
    "\n",
    "print(f\"OpenAI API key loaded from {load_api_key()}.\")"
   ]
  },
