   "source": [
    "The client and the five models this demo uses.\n",
    "Each model name is written once, as a constant, so switching a model is a one-line change.\n",
    "\n",
    "| Constant | Model | Used for | Price |\n",
    "| --- | --- | --- | --- |\n",
    "| `MODEL` | `gpt-6-luna` | Everything that generates text: chat, tools, agents, guardrail checks, the judge, images | $0.10 per 1M input tokens, $0.50 per 1M output tokens |\n",
    "| `EMBED_MODEL` | `text-embedding-3-small` | Turning text into vectors for retrieval (Part 2) | $0.02 per 1M tokens |\n",
    "| `MODERATION_MODEL` | `omni-moderation-latest` | Flagging harmful text (Part 2) | Free |\n",
    "| `TTS_MODEL` | `gpt-4o-mini-tts` | Text to speech (section 5) | About $0.015 per minute of audio |\n",
    "| `STT_MODEL` | `gpt-transcribe` | Speech to text (section 5) | $0.0045 per minute of audio |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "99879c7e",
   "metadata": {},
   "outputs": [],
   "source": [
    "from openai import OpenAI\n",
    "\n",
    "# The only models this demo uses. A course key may allow exactly these five and nothing else.\n",
    "MODEL = \"gpt-6-luna\"  # every generation call: chat, tools, agents, guardrail checks, the judge, images\n",
    "EMBED_MODEL = \"text-embedding-3-small\"  # turns text into vectors for retrieval\n",
    "MODERATION_MODEL = \"omni-moderation-latest\"  # flags harmful text; free\n",
    "TTS_MODEL = \"gpt-4o-mini-tts\"  # text to speech\n",
    "STT_MODEL = \"gpt-transcribe\"  # speech to text\n",
    "VOICE = \"sage\"  # one of the built-in text-to-speech voices\n",
    "\n",
    "# Always set the reasoning effort: the model's default (\"medium\") is slow for simple tasks.\n",
    "FAST_REASONING = {\"effort\": \"none\"}\n",
    "\n",
    "client = OpenAI(\n",
    "    timeout=60.0,\n",
    "    max_retries=2,  # retries 429s, 5xx errors, and timeouts\n",
    "    default_headers={\"Accept-Encoding\": \"identity\"},  # workaround: skip the broken decompressor\n",
    ")  # reads OPENAI_API_KEY from the environment"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "41541f52",
   "metadata": {},
   "source": [
    "Every call in these notebooks is logged: model, tokens, seconds of audio, latency, and estimated cost.\n",
    "Your project needs the same kind of log, so feel free to copy this cell."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "64f296ed",
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title Usage log: tokens, audio, latency, and cost of every call (expand to read)\n",
    "import pandas as pd\n",
    "from datetime import date\n",
    "import time\n",
    "from IPython.display import Markdown, display\n",
    "\n",
    "# USD per 1M tokens: (input, cached input, output), standard tier. Update these if you change a model above.\n",
    "# Prices change, so check https://developers.openai.com/api/docs/pricing\n",
    "PRICES = {\n",
    "    MODEL: (0.10, 0.01, 0.50),\n",
    "    EMBED_MODEL: (0.02, 0.02, 0.0),\n",
    "    MODERATION_MODEL: (0.0, 0.0, 0.0),  # free\n",
    "}\n",
    "# USD per minute of audio. Speech to text is billed per minute. Text to speech is billed per token\n",
    "# ($0.60 per 1M text tokens in, $12 per 1M audio tokens out), which comes to about $0.015 per minute of speech.\n",
    "AUDIO_PRICES = {TTS_MODEL: 0.015, STT_MODEL: 0.0045}\n",
    "USAGE_LOG = []  # one row per model call\n",
    "\n",
    "\n",
    "def log_usage(label, model, seconds, input_tokens=0, output_tokens=0, cached_tokens=0, reasoning_tokens=0, audio_seconds=0.0):\n",
    "    \"\"\"Add one model call to USAGE_LOG (tokens, audio, latency, estimated cost) and return the row.\"\"\"\n",
    "    known = [*PRICES, *AUDIO_PRICES]\n",
    "    # Match the longest known name, so dated snapshots work and one name can't shadow another that starts with it.\n",
    "    matches = [p for p in known if model == p or model.startswith(p + \"-\")]\n",
    "    name = max(matches, key=len) if matches else model\n",
    "    if name not in known:\n",
    "        print(f\"Note: no price for {model!r}; add it to PRICES. Counting it as $0 for now.\")\n",
    "        PRICES[name] = (0.0, 0.0, 0.0)\n",
    "    p_in, p_cached, p_out = PRICES.get(name, (0.0, 0.0, 0.0))\n",
    "    cost = ((input_tokens - cached_tokens) * p_in + cached_tokens * p_cached + output_tokens * p_out) / 1e6\n",
    "    cost += audio_seconds / 60 * AUDIO_PRICES.get(name, 0.0)\n",
    "    row = {\n",
    "        \"label\": label,\n",
    "        \"model\": name,\n",
    "        \"input\": input_tokens,\n",
    "        \"cached\": cached_tokens,\n",
    "        \"output\": output_tokens,\n",
    "        \"reasoning\": reasoning_tokens,\n",
    "        \"audio_s\": round(audio_seconds, 1),\n",
    "        \"seconds\": round(seconds, 2),\n",
    "        \"cost_usd\": cost,\n",
    "    }\n",
    "    USAGE_LOG.append(row)\n",
    "    return row\n",
    "\n",
    "\n",
    "def log_response(label, response, seconds):\n",
    "    \"\"\"Log a Responses API result: its usage has input, cached, output, and reasoning token counts.\"\"\"\n",
    "    u = response.usage\n",
    "    cached = getattr(u.input_tokens_details, \"cached_tokens\", 0) or 0\n",
    "    reasoning = getattr(u.output_tokens_details, \"reasoning_tokens\", 0) or 0\n",
    "    return log_usage(label, response.model, seconds, u.input_tokens, u.output_tokens, cached, reasoning)\n",
    "\n",
    "\n",
    "def usage_summary(rows=None):\n",
    "    \"\"\"Calls, tokens, audio seconds, summed latency, and cost per model, plus a total row.\"\"\"\n",
    "    df = pd.DataFrame(USAGE_LOG if rows is None else rows)\n",
    "    if df.empty:\n",
    "        return df\n",
    "    summary = df.groupby(\"model\").agg(\n",
    "        calls=(\"label\", \"size\"),\n",
    "        input=(\"input\", \"sum\"),\n",
    "        cached=(\"cached\", \"sum\"),\n",
    "        output=(\"output\", \"sum\"),\n",
    "        reasoning=(\"reasoning\", \"sum\"),\n",
    "        audio_s=(\"audio_s\", \"sum\"),\n",
    "        seconds=(\"seconds\", \"sum\"),\n",
    "        cost_usd=(\"cost_usd\", \"sum\"),\n",
    "    )\n",
    "    summary.loc[\"total\"] = summary.sum()\n",
    "    counts = [\"calls\", \"input\", \"cached\", \"output\", \"reasoning\"]\n",
    "    return summary.astype({c: int for c in counts}).round({\"audio_s\": 1, \"seconds\": 1, \"cost_usd\": 5})\n",
    "\n",
    "def llm(label, model=MODEL, **kwargs):\n",
    "    \"\"\"Call the Responses API, log tokens, latency, and cost under `label`, and return the response.\n",
    "\n",
    "    Uses FAST_REASONING unless you pass a reasoning setting. With text_format=<Pydantic model>\n",
    "    it uses responses.parse, which returns a structured output in response.output_parsed.\n",
    "    \"\"\"\n",
    "    kwargs.setdefault(\"reasoning\", FAST_REASONING)\n",
    "    call = client.responses.parse if \"text_format\" in kwargs else client.responses.create\n",
    "    t0 = time.perf_counter()\n",
    "    response = call(model=model, **kwargs)\n",
    "    log_response(label, response, time.perf_counter() - t0)\n",
    "    return response\n",
    "\n",
    "def show(text):\n",
    "    \"\"\"Display a model's answer as formatted Markdown instead of raw asterisks.\"\"\"\n",
    "    display(Markdown(text))\n",
    "\n",
    "INSTRUCTIONS = (\n",
    "    \"You are an assistant in charge of managing calendar events. \"\n",
    "    \"Do not use em dashes.\"\n",
    ")\n",
    "\n",
    "TODAY = date.today()"
   ]
  },
