   "source": [
    "Test models ability with ambiguous or incomplete prompts, along with overlapping EVENTS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "3f8b4b03",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
