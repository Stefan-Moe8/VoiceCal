    "from pydantic import BaseModel\n",
    "\n",
    "class Event(BaseModel):\n",
    "    type: str\n",
    "    day: str  # YYYY-MM-DD\n",
    "    time: str  # HH:MM, 24-hour\n",
    "    description: str\n",
    "\n",
    "\n",
    "response = llm(\n",
    "    \"build event\",\n",
    "    instructions=INSTRUCTIONS,\n",
    "    input=f\"Today is {TODAY}. I have Thanksgiving dinner on Thursday at 4:00 PM. Build an event.\",\n",
    "    text_format=Event,\n",
    "    max_output_tokens=300,\n",
    ")\n",
    "event = response.output_parsed  # an Event object, not text\n",
    "print(event.model_dump_json(indent=2))\n",
    "# EVENTS.append(event.model_dump())"
   ]
