    "import json\n",
    "\n",
    "TODAY = \"2026-11-22\"  # Hardcoded for testing \n",
    "\n",
    "EVENTS = [\n",
    "    {\"type\": \"exam\",     \"day\": \"2026-11-24\", \"time\": \"10:00\", \"duration_min\": 90,  \"description\": \"Macroeconomics midterm\"},\n",
    "    {\"type\": \"class\",    \"day\": \"2026-11-24\", \"time\": \"10:00\", \"duration_min\": 75,  \"description\": \"History lecture\"},       # same start as exam\n",
    "    {\"type\": \"meeting\",  \"day\": \"2026-11-24\", \"time\": \"11:15\", \"duration_min\": 60,  \"description\": \"Study group\"},           # overlaps exam end\n",
    "    {\"type\": \"meeting\",  \"day\": \"2026-11-24\", \"time\": \"12:15\", \"duration_min\": 30,  \"description\": \"Advisor check-in\"},      # back-to-back\n",
    "    {\"type\": \"holiday\",  \"day\": \"2026-11-26\", \"time\": \"16:00\", \"duration_min\": 180, \"description\": \"Thanksgiving dinner\"},\n",
    "    {\"type\": \"deadline\", \"day\": \"2026-12-04\", \"time\": \"23:59\", \"duration_min\": 0,   \"description\": \"History paper due\"},\n",
    "]\n",
    "\n",
    "# (name, prompt, what a good answer does)\n",
    "TESTS = [\n",
    "    (\"missing month\",     \"What do I have on the 24th?\",               \"Assumes Nov 24 (the next one) and lists all 3 events, or confirms the month\"),\n",
    "    (\"relative day\",      \"Am I free Tuesday morning?\",                \"Resolves Tuesday to Nov 24 and says no, with the overlapping events\"),\n",
    "    (\"overlap check\",     \"Do I have any conflicts?\",                  \"Flags exam/lecture (same start) and exam/study group (overlap); notes advisor is back-to-back, not a conflict\"),\n",
    "    (\"new event, clash\",  \"Schedule lunch with Sam at 10:15 on Nov 24.\", \"Warns it clashes with the exam and lecture instead of silently adding it\"),\n",
    "    (\"no referent\",       \"Cancel it.\",                                \"Asks what 'it' is. Does not guess\"),\n",
    "    (\"missing details\",   \"Add a dentist appointment.\",                \"Asks for day and time. Does not invent them\"),\n",
    "    (\"ambiguous move\",    \"Move my study group to Friday.\",            \"Asks for a time, or notes the study group is on Nov 24 and picks Nov 27 only after confirming\"),\n",
    "    (\"AM/PM + weekday\",   \"Add a meeting at 3 on Thursday.\",           \"Resolves Thursday to Nov 26, asks AM or PM, and notes Thanksgiving dinner that day\"),\n",
    "    (\"vague range\",       \"What's coming up soon?\",                    \"Picks a reasonable window and says what it chose\"),\n",
    "    (\"nonexistent event\", \"When is my chemistry final?\",               \"Says there is no such event. Does not make one up\"),\n",
    "]\n",
    "\n",
    "BASELINE = \"You are an assistant in charge of managing calendar events. Do not use em dashes.\"\n",
    "\n",
    "STRICT = (\n",
    "    BASELINE\n",
    "    + \" Events have a start time and a duration, so two events overlap if their time ranges intersect. \"\n",
    "    \"If a request is ambiguous or missing details (day, time, AM or PM, which event), ask one short clarifying \"\n",
    "    \"question instead of guessing. Never invent events. When you add or move an event, check it against the \"\n",
    "    \"existing events and warn about any overlap.\"\n",
    ")\n",
    "\n",
    "\n",
    "def run_tests(instructions, tag):\n",
    "    for name, prompt, expect in TESTS:\n",
    "        response = llm(\n",
    "            f\"{tag}: {name}\",\n",
    "            instructions=instructions,\n",
    "            input=(\n",
    "                f\"Today is {TODAY}. Here are my events as JSON:\\n\"\n",
    "                f\"{json.dumps(EVENTS, indent=2)}\\n\\n\"\n",
    "                f\"{prompt}\"\n",
    "            ),\n",
    "            max_output_tokens=300,\n",
    "        )\n",
    "        print(f\"\\n[{tag}] {name}\\nPrompt:   {prompt}\\nExpected: {expect}\")\n",
    "        show(response.output_text)\n",
    "\n",
    "\n",
    "run_tests(BASELINE, \"baseline\")\n",
    "run_tests(STRICT, \"strict\")\n",
    "usage_summary()"
   ]
  }
 ],
